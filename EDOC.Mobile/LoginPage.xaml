<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EDOC.Mobile.ViewModels"
             x:Class="EDOC.Mobile.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="E-DOC"
             Shell.NavBarIsVisible="False">
    <Grid Background="{StaticResource CanvasGlowBrush}">
        <ScrollView>
            <VerticalStackLayout Padding="28,36" Spacing="18" MaximumWidthRequest="500" HorizontalOptions="Center">
                <Border WidthRequest="62" HeightRequest="62" BackgroundColor="White" Padding="3" StrokeThickness="0" StrokeShape="RoundRectangle 19" HorizontalOptions="Start">
                    <Image Source="edoc_logo.png" Aspect="AspectFit" />
                </Border>
                <Label Text="E-DOC HEALTHCARE" Style="{StaticResource Eyebrow}" />
                <Label Text="{Binding SubmitText}" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding LoginIntro}" Style="{StaticResource BodySecondary}" />
                <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Picker Title="{Binding AccountTypeText}" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType}" IsVisible="{Binding IsRegistering}" />
                        <Entry Placeholder="{Binding FullNameText}" Text="{Binding FullName}" IsVisible="{Binding IsRegistering}" Style="{StaticResource CustomEntry}" />
                        <Entry Placeholder="{Binding LoginIdentifierText}" Text="{Binding Email}" Keyboard="Text" Style="{StaticResource CustomEntry}" />
                        <Entry Placeholder="{Binding PhoneText}" Text="{Binding PhoneNumber}" Keyboard="Telephone" IsVisible="{Binding IsRegistering}" Style="{StaticResource CustomEntry}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Placeholder="{Binding PasswordText}" Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" Style="{StaticResource CustomEntry}" />
                            <Button Grid.Column="1" Text="{Binding PasswordVisibilityText}" Command="{Binding TogglePasswordVisibilityCommand}" Style="{StaticResource QuietButton}" FontSize="12" VerticalOptions="Center" />
                        </Grid>
                        <Entry Placeholder="{Binding ConfirmPasswordText}" Text="{Binding ConfirmPassword}" IsPassword="{Binding IsPasswordHidden}" IsVisible="{Binding IsRegistering}" Style="{StaticResource CustomEntry}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsNotRegistering}">
                            <CheckBox IsChecked="{Binding IsRememberMe}" Color="{StaticResource Blue}" />
                            <Label Grid.Column="1" Text="{Binding RememberMeText}" Style="{StaticResource BodySecondary}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding Message}" TextColor="{StaticResource Emergency}" FontSize="13" LineBreakMode="WordWrap" />
                        <Button Text="{Binding SubmitText}" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Style="{StaticResource LoadingIndicator}" />
                        <Button Text="{Binding ToggleModeText}" Command="{Binding ToggleModeCommand}" Style="{StaticResource QuietButton}" />
                        <Button Text="{Binding ForgotPasswordText}" Command="{Binding ForgotPasswordCommand}" IsVisible="{Binding IsNotRegistering}" Style="{StaticResource QuietButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
