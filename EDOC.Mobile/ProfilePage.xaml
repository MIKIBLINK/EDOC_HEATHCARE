<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EDOC.Mobile.ViewModels"
             xmlns:models="clr-namespace:EDOC.Mobile.Models"
             x:Class="EDOC.Mobile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             x:Name="RootPage">
    <Grid Background="{StaticResource CanvasGlowBrush}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageInset}" Spacing="18" MaximumWidthRequest="700" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding ProfileIntro}" Style="{StaticResource BodySecondary}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource GlassCard}" Padding="18">
                <Grid ColumnDefinitions="62,*" ColumnSpacing="14">
                    <Border WidthRequest="58" HeightRequest="58" BackgroundColor="{StaticResource Mint}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <Image Source="profile.svg" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="E-DOC" FontSize="18" FontAttributes="Bold" IsVisible="{Binding IsSignedOut}" />
                        <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" IsVisible="{Binding IsSignedIn}" />
                        <Label Text="{Binding Message}" Style="{StaticResource BodySecondary}" />
                        <Button Text="{Binding SignInText}" Command="{Binding SignInCommand}" IsVisible="{Binding IsSignedOut}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="18" IsVisible="{Binding IsPatientProfile}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding FullNameText}" Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding FullName}" Style="{StaticResource CustomEntry}" ReturnType="Next" />
                    <Label Text="{Binding EmailText}" Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding Email}" IsReadOnly="True" Style="{StaticResource CustomEntry}" />
                    <Label Text="{Binding PhoneText}" Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" Style="{StaticResource CustomEntry}" ReturnType="Next" />
                    <Label Text="{Binding DateOfBirthText}" Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding DateOfBirth}" Placeholder="{Binding DateFormatHint}" Style="{StaticResource CustomEntry}" ReturnType="Next" />
                    <Label Text="{Binding GenderText}" Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding Gender}" Style="{StaticResource CustomEntry}" ReturnType="Next" />
                    <Label Text="{Binding AddressText}" Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding Address}" Style="{StaticResource CustomEntry}" ReturnType="Next" />
                    <Label Text="{Binding EmergencyContactText}" Style="{StaticResource Eyebrow}" Margin="0,8,0,0" />
                    <Entry Text="{Binding EmergencyContactName}" Placeholder="{Binding FullNameText}" Style="{StaticResource CustomEntry}" ReturnType="Next" />
                    <Entry Text="{Binding EmergencyContactPhone}" Placeholder="{Binding PhoneText}" Keyboard="Telephone" Style="{StaticResource CustomEntry}" />
                    <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="18" IsVisible="{Binding IsPatientProfile}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding CaregiverAccessTitle}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding CaregiverInviteHint}" Style="{StaticResource BodySecondary}" />
                    <Entry Text="{Binding CaregiverEmail}" Placeholder="{Binding EmailText}" Keyboard="Email" Style="{StaticResource CustomEntry}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding ShareAppointments}" Color="{StaticResource Blue}" />
                        <Label Grid.Column="1" Text="{Binding ShareAppointmentsText}" Style="{StaticResource BodySecondary}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding ShareMedicalRecords}" Color="{StaticResource Blue}" />
                        <Label Grid.Column="1" Text="{Binding ShareMedicalRecordsText}" Style="{StaticResource BodySecondary}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding ShareMedicationReminders}" Color="{StaticResource Blue}" />
                        <Label Grid.Column="1" Text="{Binding ShareMedicationRemindersText}" Style="{StaticResource BodySecondary}" VerticalOptions="Center" />
                    </Grid>
                    <Button Text="{Binding InviteCaregiverText}" Command="{Binding InviteCaregiverCommand}" Style="{StaticResource PrimaryButton}" />
                    <CollectionView ItemsSource="{Binding CaregiverLinks}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CaregiverConnectionCard">
                                <Border Style="{StaticResource SubtleCard}" Padding="12" Margin="0,4">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding CaregiverName}" FontAttributes="Bold" />
                                        <Label Text="{Binding InviteEmail}" Style="{StaticResource BodySecondary}" />
                                        <Label Text="{Binding AcceptedAt, StringFormat='Accepted {0:g}', TargetNullValue='Invitation pending'}" Style="{StaticResource BodySecondary}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <Button Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleAppointmentAccessText}"
                                                    Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleCaregiverAppointmentsCommand}"
                                                    CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" FontSize="11" />
                                            <Button Grid.Column="1" Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleRecordAccessText}"
                                                    Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleCaregiverRecordsCommand}"
                                                    CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" FontSize="11" />
                                        </Grid>
                                        <Button Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleMedicationReminderAccessText}"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleCaregiverRemindersCommand}"
                                                CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" FontSize="12" />
                                        <Button Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.RevokeAccessText}"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.RevokeCaregiverCommand}"
                                                CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding SettingsTitle}" Style="{StaticResource SectionTitle}" Margin="0,6,0,0" />
            <Border Style="{StaticResource GlassCard}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding LanguageTitle}" FontAttributes="Bold" />
                            <Label Text="{Binding CurrentLanguageText}" Style="{StaticResource BodySecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{Binding LanguageButtonText}" Command="{Binding ToggleLanguageCommand}" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" Padding="12,8" FontSize="12" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,0" />
                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding DarkModeLabel}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode}" OnColor="{StaticResource Teal}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,0" />
                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding NotificationsLabel}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" OnColor="{StaticResource Teal}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,0" />
                    <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding PrivacyTitle}" FontAttributes="Bold" />
                            <Label Text="{Binding PrivacyMessage}" Style="{StaticResource BodySecondary}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="›" Command="{Binding ShowPrivacyCommand}" Style="{StaticResource IconButton}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SignOutText}" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" Style="{StaticResource QuietButton}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
