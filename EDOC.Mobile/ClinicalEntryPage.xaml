<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EDOC.Mobile.ViewModels"
             x:Class="EDOC.Mobile.ClinicalEntryPage"
             x:DataType="vm:ClinicalEntryViewModel">
    <ScrollView Background="{StaticResource CanvasGlowBrush}">
        <VerticalStackLayout Padding="{StaticResource PageInset}" Spacing="16" MaximumWidthRequest="620" HorizontalOptions="Center">
            <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding Intro}" Style="{StaticResource BodySecondary}" />
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <VerticalStackLayout Spacing="13">
                    <Label Text="{Binding RecordTypeLabel}" Style="{StaticResource BodySecondary}" />
                    <Picker ItemsSource="{Binding RecordTypes}" SelectedIndex="{Binding SelectedRecordType}" />
                    <Entry Placeholder="{Binding FirstFieldLabel}" Text="{Binding FirstField}" />
                    <Entry Placeholder="{Binding SecondFieldLabel}" Text="{Binding SecondField}" />
                    <Entry Placeholder="{Binding ThirdFieldLabel}" Text="{Binding ThirdField}" />
                    <Entry Placeholder="{Binding FourthFieldLabel}" Text="{Binding FourthField}" IsVisible="{Binding ShowFourthField}" />
                    <Editor Placeholder="{Binding NotesLabel}" Text="{Binding Notes}" AutoSize="TextChanges" />
                    <Label Text="{Binding Message}" TextColor="{StaticResource Danger}" />
                    <Button Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Style="{StaticResource LoadingIndicator}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
