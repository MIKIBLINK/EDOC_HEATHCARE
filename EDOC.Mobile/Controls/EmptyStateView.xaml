<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EDOC.Mobile.Controls"
             x:Class="EDOC.Mobile.Controls.EmptyStateView"
             x:Name="Root"
             x:DataType="controls:EmptyStateView">
    <VerticalStackLayout Padding="28,36" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="360">
        <Border WidthRequest="58" HeightRequest="58" BackgroundColor="{StaticResource Mint}" StrokeThickness="0" StrokeShape="RoundRectangle 20" HorizontalOptions="Center">
            <Label Text="✦" FontSize="26" TextColor="{StaticResource Blue}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <Label Text="{Binding Message, Source={x:Reference Root}}"
               Style="{StaticResource BodySecondary}"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentView>
