<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EDOC.Mobile.SplashPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Background="{StaticResource CanvasGlowBrush}">
    <Grid Padding="32" RowDefinitions="*,Auto,Auto" RowSpacing="18">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="18">
            <Border WidthRequest="116"
                    HeightRequest="116"
                    BackgroundColor="White"
                    Padding="7"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 32"
                    Shadow="{StaticResource CardShadow}">
                <Image Source="edoc_logo.png" Aspect="AspectFit" />
            </Border>

            <Label Text="E-DOC"
                   FontSize="34"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Blue}" />

            <Label Text="{Binding Tagline}"
                   FontSize="16"
                   TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="Center">
            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource Blue}"
                               WidthRequest="28"
                               HeightRequest="28" />
            <Label Text="{Binding LoadingText}"
                   FontAttributes="Bold"
                   FontSize="13"
                   TextColor="{StaticResource Blue}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
