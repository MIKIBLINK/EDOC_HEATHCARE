<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EDOC.Mobile.ViewModels"
             xmlns:models="clr-namespace:EDOC.Mobile.Models"
             x:Class="EDOC.Mobile.CaregiverPage"
             x:DataType="vm:CaregiverViewModel"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False">
    <Grid Background="{StaticResource CanvasGlowBrush}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageInset}" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <Button Grid.Column="1" Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.RefreshText}" Command="{Binding LoadCommand}" Style="{StaticResource QuietButton}" />
                </Grid>
                <Label Text="{Binding Intro}" Style="{StaticResource BodySecondary}" />
                <Border Style="{StaticResource GlassCard}" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding AcceptInvitationTitle}" Style="{StaticResource SectionTitle}" />
                        <Entry Text="{Binding InvitationId}" Placeholder="{Binding InvitationIdText}" Style="{StaticResource CustomEntry}" />
                        <Entry Text="{Binding InvitationToken}" Placeholder="{Binding InvitationTokenText}" Style="{StaticResource CustomEntry}" />
                        <Button Text="{Binding AcceptInvitationText}" Command="{Binding AcceptInvitationCommand}" Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource GlassCard}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding PatientsTitle}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding NoPatients}" Style="{StaticResource BodySecondary}" IsVisible="{Binding HasNoPatients}" />
                        <CollectionView ItemsSource="{Binding Patients}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CaregiverPatientCard">
                                    <Border Style="{StaticResource SubtleCard}" Padding="14" Margin="0,4">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding PatientName}" FontAttributes="Bold" FontSize="17" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                                <Button Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.RecordsButton}"
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowRecordsCommand}"
                                                        CommandParameter="{Binding .}" IsEnabled="{Binding CanViewMedicalRecords}" Style="{StaticResource SecondaryButton}" FontSize="12" />
                                                <Button Grid.Column="1" Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.AppointmentsButton}"
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowAppointmentsCommand}"
                                                        CommandParameter="{Binding .}" IsEnabled="{Binding CanViewAppointments}" Style="{StaticResource SecondaryButton}" FontSize="12" />
                                            </Grid>
                                            <Button Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.RemindersButton}"
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowRemindersCommand}"
                                                        CommandParameter="{Binding .}" IsEnabled="{Binding CanViewMedicationReminders}" Style="{StaticResource SecondaryButton}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding Message}" Style="{StaticResource BodySecondary}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Style="{StaticResource LoadingIndicator}" />
                <Border Style="{StaticResource GlassCard}" Padding="18" IsVisible="{Binding HasSelectedPatient}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding SelectedPatientName}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding RecordsTitle}" FontAttributes="Bold" />
                        <Label Text="{Binding NoRecords}" IsVisible="{Binding HasNoRecords}" Style="{StaticResource BodySecondary}" />
                        <CollectionView ItemsSource="{Binding Records}" MaximumHeightRequest="320" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ClinicalRecordCard">
                                    <VerticalStackLayout Padding="8" Spacing="3">
                                        <Label Text="{Binding RecordType}" FontAttributes="Bold" />
                                        <Label Text="{Binding Summary}" Style="{StaticResource BodySecondary}" />
                                    <Label Text="{Binding RecordedAt, StringFormat='{0:g}'}" Style="{StaticResource BodySecondary}" FontSize="11" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Diagnoses}" Spacing="3">
                                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:DiagnosisCard">
                                            <Label Text="{Binding Display}" Style="{StaticResource BodySecondary}" LineBreakMode="WordWrap" />
                                        </DataTemplate></BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LabResults}" Spacing="3">
                                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:LabResultCard">
                                            <Label Text="{Binding TestName}" Style="{StaticResource BodySecondary}" />
                                        </DataTemplate></BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Prescriptions}" Spacing="3">
                                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:PrescriptionCard">
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="2">
                                                <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:PrescriptionItemCard">
                                                    <Label Text="{Binding MedicationName}" Style="{StaticResource BodySecondary}" />
                                                </DataTemplate></BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </DataTemplate></BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderLight}" />
                        <Label Text="{Binding RemindersTitle}" FontAttributes="Bold" />
                        <Label Text="{Binding NoReminders}" IsVisible="{Binding HasNoReminders}" Style="{StaticResource BodySecondary}" />
                        <CollectionView ItemsSource="{Binding Reminders}" MaximumHeightRequest="260" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:MedicationReminderCard">
                                    <VerticalStackLayout Padding="8" Spacing="3">
                                        <Label Text="{Binding MedicationName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Dosage}" Style="{StaticResource BodySecondary}" />
                                        <Label Text="{Binding ScheduledAt, StringFormat='{0:g}'}" Style="{StaticResource BodySecondary}" FontSize="11" />
                                        <Label Text="{Binding ScheduleLabel}" Style="{StaticResource BodySecondary}" FontSize="11" />
                                        <Label Text="{Binding LastDoseStatusLabel}" Style="{StaticResource BodySecondary}" FontSize="11" />
                                        <Label Text="{Binding StatusLabel}" Style="{StaticResource BodySecondary}" FontSize="11" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderLight}" />
                        <Label Text="{Binding AppointmentsTitle}" FontAttributes="Bold" />
                        <Label Text="{Binding NoAppointments}" IsVisible="{Binding HasNoAppointments}" Style="{StaticResource BodySecondary}" />
                        <CollectionView ItemsSource="{Binding Appointments}" MaximumHeightRequest="320" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SharedAppointmentCard">
                                    <VerticalStackLayout Padding="8" Spacing="3">
                                        <Label Text="{Binding DoctorName}" FontAttributes="Bold" />
                                        <Label Text="{Binding StartsAt, StringFormat='{0:g}'}" Style="{StaticResource BodySecondary}" />
                                        <Label Text="{Binding Status}" Style="{StaticResource BodySecondary}" FontSize="11" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
