<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EDOC.Mobile.ViewModels"
             xmlns:models="clr-namespace:EDOC.Mobile.Models"
             xmlns:controls="clr-namespace:EDOC.Mobile.Controls"
             x:Class="EDOC.Mobile.DoctorsPage"
             x:DataType="vm:DoctorsViewModel"
             x:Name="DoctorsRoot">
    <Grid Background="{StaticResource CanvasGlowBrush}" RowDefinitions="Auto,Auto,Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="22,20,22,4" Spacing="4" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Label Text="{Binding SearchTitle}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding Intro}" Style="{StaticResource BodySecondary}" />
        </VerticalStackLayout>
        <Border Grid.Row="1" Style="{StaticResource GlassInput}" Padding="8,0" Margin="22,12,22,4" MaximumWidthRequest="716" HorizontalOptions="Center">
            <SearchBar Text="{Binding SearchText}" Placeholder="{Binding SearchHint}" SearchCommand="{Binding SearchCommand}" Style="{StaticResource SearchBarStyle}" />
        </Border>
        <FlexLayout Grid.Row="2" Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" Margin="22,0,22,4" MaximumWidthRequest="716" HorizontalOptions="Center">
            <Picker Title="{Binding SpecialtyFilterLabel}" ItemsSource="{Binding SpecialtyOptions}" SelectedItem="{Binding SelectedSpecialty}" ItemDisplayBinding="{Binding Label}" WidthRequest="220" />
            <Picker Title="{Binding HospitalFilterLabel}" ItemsSource="{Binding HospitalOptions}" SelectedItem="{Binding SelectedHospital}" ItemDisplayBinding="{Binding Label}" WidthRequest="220" />
        </FlexLayout>
        <RefreshView Grid.Row="3" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding FilteredDoctors}" SelectionMode="None" Margin="22,12" MaximumWidthRequest="716" HorizontalOptions="Center">
                <CollectionView.EmptyView>
                    <controls:EmptyStateView Message="{Binding StatusMessage}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DoctorCard">
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="17">
                            <Grid ColumnDefinitions="52,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="13" RowSpacing="5">
                                <Border WidthRequest="50" HeightRequest="50" BackgroundColor="{StaticResource Mint}" StrokeThickness="0" StrokeShape="RoundRectangle 17" VerticalOptions="Start">
                                    <Image Source="doctors.svg" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Specialty}" FontSize="14" TextColor="{StaticResource Blue}" />
                                    <Label Text="{Binding Hospital}" Style="{StaticResource BodySecondary}" />
                                    <Label Text="{Binding Qualifications}" Style="{StaticResource BodySecondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Grid.Row="2" Text="{Binding Source={x:Reference DoctorsRoot}, Path=BindingContext.DetailsText}"
                                        Command="{Binding Source={x:Reference DoctorsRoot}, Path=BindingContext.OpenDetailsCommand}"
                                        CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" Padding="10,8" />
                                <Button Grid.Column="2" Grid.RowSpan="3" Text="{Binding Source={x:Reference DoctorsRoot}, Path=BindingContext.BookText}"
                                        Command="{Binding Source={x:Reference DoctorsRoot}, Path=BindingContext.BookDoctorCommand}"
                                        CommandParameter="{Binding .}" Style="{StaticResource PrimaryButton}" VerticalOptions="Center" Padding="14,10" FontSize="13" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
